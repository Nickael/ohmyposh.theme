{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "palette": {
    "nord0": "#2E3440",
    "nord1": "#3B4252",
    "nord2": "#434C5E",
    "nord3": "#4C566A",
    "nord4": "#D8DEE9",
    "nord5": "#E5E9F0",
    "nord6": "#ECEFF4",
    "nord7": "#8FBCBB",
    "nord8": "#88C0D0",
    "nord9": "#81A1C1",
    "nord10": "#5E81AC",
    "nord11": "#BF616A",
    "nord12": "#D08770",
    "nord13": "#EBCB8B",
    "nord14": "#A3BE8C",
    "nord15": "#B48EAD",
    "teal": "#2e9599",
    "docker_blue": "#348cba",
    "npm_red": "#cc3a3a"
  },
  "console_title_template": "{{.Folder}}{{if .Root}} | root{{end}} - {{.Shell}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "trailing_diamond": "<p:nord10,transparent>\u2592</>",
          "foreground": "p:nord4",
          "background": "p:nord3",
          "templates": [
            "{{ if .Root }}<p:nord12,p:nord1> \udb86\udc53 </>{{ end }}",
            "{{ if .SSHSession }} 👾{{ end }}",
            " {{ .UserName }} "
          ]
        },
        {
          "type": "path",
          "style": "diamond",
          "trailing_diamond": "<p:nord1,transparent>\ue0b0</>",
          "foreground": "p:nord6",
          "background": "p:nord1",
          "template": " {{ .Path }} ",
          "options": {
            "folder_icon": "\ue5fe",
            "folder_separator_icon": " <p:nord3,p:transparent>\ue0b1</> ",
            "home_icon": "🏠",
            "mapped_locations": {
              "/home/nr/Workspaces": "👾",
              "/Users/nr/Workspaces": "👾"
            },
            "style": "mixed"
          }
        },
        {
          "type": "ruby",
          "style": "diamond",
          "trailing_diamond": "<#58647A,transparent>\ue0b0</>",
          "foreground": "p:nord11",
          "background": "p:nord1",
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "trailing_diamond": "<#58647A,transparent>\ue0b0</>",
          "foreground": "p:nord13",
          "background": "p:nord1",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "upgrade",
          "style": "plain",
          "template": " [ <#58647A,transparent>{{.Current}}</> -> <p:nord14,transparent>{{.Latest}}</} ] "
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:nord6",
          "background": "transparent",
          "template": "<p:nord6> </>{{ if .Staging.Changed }}<p:nord14> \udb86\udc53 {{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }}<#ff8080> \udb86\udc53 {{ .Working.String }}</>{{ end }}<p:nord6s> </>",
          "options": {
            "branch_icon": "\ue725 ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "shell",
          "style": "diamond",
          "foreground": "#ef5350",
          "template": " {{ .Name }} ",
          "options": {
            "mapped_shell_names": {
              "pwsh": "PS"
            }
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:nord10",
          "template": "<p:teal,transparent>{{ .HEAD }}</>",
          "options": {
            "branch_icon": "\uE725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "nx",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:nord1",
          "background": "p:nord10",
          "template": " \ue753 {{ .Full }} "
        },
        {
          "type": "angular",
          "style": "diamond",
          "foreground": "p:nord10",
          "template": " \ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "node",
          "style": "diamond",
          "foreground": "p:nord14",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <p:npm_red>\ue5fa</> ",
            "yarn_icon": " <p:docker_blue>\ue6a7</>"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "foreground": "p:teal",
          "template": " \ueb2c <background, transparent></>",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:nord11{{ end }}"
          ],
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}